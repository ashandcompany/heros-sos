# URL de base de l'API REST Go, préfixe compris. Lue par le serveur Next uniquement (jamais exposée
# au navigateur). Vide : toute l'application tourne sur les mocks. Renseignée : connexion, session et
# déconnexion passent par l'API, le reste reste mocké (voir docs/backend-contract.md).
#   npm run dev + API de `make up-dev` : http://localhost:8081/api/v1
#   npm run dev + API lancée avec `go run` : http://localhost:8080/api/v1
API_URL=

# Fond de la carte des incidents (lu par le serveur Next, voir src/lib/map.ts). Vide : tuiles
# publiques d'OpenStreetMap, réservées au développement et aux faibles trafics (politique d'usage).
# Exemple, Plan IGN de la Géoplateforme (gratuit, sans clé) :
#   MAP_TILE_URL=https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2&STYLE=normal&TILEMATRIXSET=PM&FORMAT=image/png&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}
#   MAP_TILE_ATTRIBUTION=© IGN – Plan IGN
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_MAX_ZOOM=

# URL publique du site, sans slash final : liens absolus du sitemap, de robots.txt et des aperçus
# Open Graph (voir src/lib/site.ts). Lue par le serveur au démarrage. Vide : http://localhost:3000.
SITE_URL=
