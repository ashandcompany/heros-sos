# Configuration du backend Heros-SOS.
# Copier vers .env (jamais versionné) ou lancer `make env`, qui génère les secrets.
# Les lignes commentées montrent la valeur par défaut. Voir internal/config pour le détail.

# --- Général -----------------------------------------------------------------------------------
# development | production | test. La production active des contrôles stricts (HTTPS, SMTP, etc.).
# HEROS_ENV=development
# Niveau des journaux de l'API : debug | info | warn | error. Format : texte lisible en développement,
# JSON en production (une ligne par événement). Voir `make logs-dev` pour les suivre.
# HEROS_LOG_LEVEL=info
# Format des journaux : json (une ligne JSON par entrée, lue par Filebeat : `make elk`) ou text. Défaut : json en
# production, text sinon.
# HEROS_LOG_FORMAT=text
# Applique les migrations SQL au démarrage (utile en développement, déconseillé en production).
# HEROS_AUTO_MIGRATE=false

# --- Serveur HTTP ------------------------------------------------------------------------------
# HEROS_HTTP_ADDR=:8080
# HEROS_HTTP_READ_HEADER_TIMEOUT=5s
# HEROS_HTTP_READ_TIMEOUT=15s
# HEROS_HTTP_WRITE_TIMEOUT=30s
# HEROS_HTTP_IDLE_TIMEOUT=60s
# HEROS_HTTP_SHUTDOWN_TIMEOUT=20s
# HEROS_HTTP_MAX_BODY_BYTES=1048576
# Délai de `api -healthcheck`, le contrôle de santé du conteneur.
# HEROS_HEALTHCHECK_TIMEOUT=3s
# Proxys dont X-Forwarded-For est cru (adresses ou réseaux, séparés par des virgules).
# HEROS_TRUSTED_PROXIES=
# Origines autorisées pour les requêtes qui modifient des données (protection CSRF).
HEROS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de données ---------------------------------------------------------------------------
HEROS_DATABASE_URL=postgres://heros:heros@localhost:5432/herossos?sslmode=disable
# HEROS_DATABASE_MAX_OPEN_CONNS=25
# HEROS_DATABASE_MAX_IDLE_CONNS=25
# HEROS_DATABASE_CONN_MAX_LIFETIME=30m
# HEROS_DATABASE_CONN_MAX_IDLE_TIME=10m
# HEROS_DATABASE_PING_TIMEOUT=5s
# Les requêtes plus lentes sont journalisées (sans leur SQL, qui peut contenir des données personnelles).
# HEROS_DATABASE_SLOW_QUERY_THRESHOLD=200ms

# --- Sessions et cookie ------------------------------------------------------------------------
# Cookie Secure et préfixe __Host- (HTTPS obligatoire). Vaut true par défaut en production.
# HEROS_COOKIE_SECURE=false
# Citoyens et héros : inactivité et durée maximale.
# HEROS_SESSION_MEMBER_IDLE=2h
# HEROS_SESSION_MEMBER_MAX=168h
# « Se souvenir de moi ».
# HEROS_SESSION_REMEMBER_IDLE=720h
# HEROS_SESSION_REMEMBER_MAX=720h
# Modérateurs.
# HEROS_SESSION_MODERATOR_IDLE=15m
# HEROS_SESSION_MODERATOR_MAX=8h
# Une écriture de last_seen_at au plus par période et par session.
# HEROS_SESSION_TOUCH_PERIOD=1m

# --- Mots de passe (argon2id) ------------------------------------------------------------------
# HEROS_ARGON2_TIME=3
# HEROS_ARGON2_MEMORY_KIB=65536
# HEROS_ARGON2_THREADS=2
# Nombre maximal de hachages simultanés (chacun consomme HEROS_ARGON2_MEMORY_KIB).
# HEROS_ARGON2_MAX_CONCURRENT=4
# HEROS_PASSWORD_MIN_LENGTH=10
# HEROS_PASSWORD_MAX_LENGTH=128

# --- Verrouillage et limitation de débit -------------------------------------------------------
# HEROS_LOCKOUT_MAX_FAILURES=5
# HEROS_LOCKOUT_BASE_DELAY=1m
# HEROS_LOCKOUT_MAX_DELAY=1h
# Format maximum/fenêtre.
# HEROS_RATE_LOGIN_PER_IP=20/15m
# HEROS_RATE_LOGIN_PER_IDENTIFIER=5/15m
# HEROS_RATE_REGISTER_PER_IP=5/1h
# HEROS_RATE_PASSWORD_RESET_PER_IP=10/1h
# HEROS_RATE_PASSWORD_RESET_PER_EMAIL=3/1h
# HEROS_RATE_INCIDENT_CREATE_PER_USER=10/1h
# Formulaire de contact, par IP.
# HEROS_RATE_CONTACT_PER_IP=5/1h
# Abonnement à la newsletter : par IP, et par adresse (pour ne pas inonder la boîte de quelqu'un d'autre).
# HEROS_RATE_NEWSLETTER_PER_IP=10/1h
# HEROS_RATE_NEWSLETTER_PER_EMAIL=3/1h
# Demandes de changement d'adresse email et envois de photo de profil, par utilisateur.
# HEROS_RATE_EMAIL_CHANGE_PER_USER=5/1h
# HEROS_RATE_AVATAR_PER_USER=20/1h
# Codes de la double authentification : par utilisateur (un code TOTP a un million de valeurs).
# HEROS_RATE_MFA_VERIFY_PER_USER=5/5m
# Envois de position d'un super-héros (l'espace héros en envoie une toutes les 5 minutes).
# HEROS_RATE_HERO_LOCATION_PER_USER=60/1h
# HEROS_RATE_MAX_TRACKED_KEYS=100000

# --- Jetons envoyés par mail -------------------------------------------------------------------
# HEROS_ACTIVATION_TOKEN_TTL=24h
# HEROS_PASSWORD_RESET_TOKEN_TTL=1h
# Validité du lien de confirmation d'un abonnement à la newsletter (lien signé, rien n'est stocké).
# HEROS_NEWSLETTER_CONFIRM_TTL=48h
# Validité du lien envoyé à la nouvelle adresse d'un compte pour la confirmer (lien signé).
# HEROS_EMAIL_CHANGE_CONFIRM_TTL=48h

# --- Double authentification (TOTP) ------------------------------------------------------------
# Impose la 2FA aux modérateurs : sans elle, leur session ne donne accès qu'à son activation. Vrai par
# défaut en production, où `false` est refusé (obligatoire avant toute mise en ligne) ; faux par défaut
# en développement, pour une démonstration.
# HEROS_MFA_MODERATOR_REQUIRED=false
# Nom du service affiché dans l'application d'authentification (Google Authenticator, Aegis…).
# HEROS_MFA_ISSUER=Heros-SOS

# --- Secrets -----------------------------------------------------------------------------------
# Toute variable HEROS_X peut aussi être fournie par un fichier : on définit alors HEROS_X_FILE avec
# le chemin du fichier (secrets Docker, /run/secrets/…). Le secret n'apparaît ni dans l'environnement
# du conteneur ni dans `docker inspect`. Définir les deux formes en même temps est une erreur.
# Exemple : HEROS_CRYPTO_KEYS_FILE=/run/secrets/crypto_keys (à la place de HEROS_CRYPTO_KEYS).
# Secret CSRF : 32 octets minimum en base64. `make env` en génère un (openssl rand -base64 32).
HEROS_CSRF_SECRET=CHANGE_ME_BASE64_32_BYTES
# Clés maîtresses du chiffrement des données personnelles, au format identifiant:base64 séparés
# par des virgules. Chaque clé fait 64 octets (openssl rand -base64 64). La clé active chiffre,
# toutes les clés déchiffrent : ajouter une clé puis changer l'identifiant actif pour la rotation.
HEROS_CRYPTO_KEYS=1:CHANGE_ME_BASE64_64_BYTES
HEROS_CRYPTO_ACTIVE_KEY_ID=1

# --- Mail --------------------------------------------------------------------------------------
# log (écrit dans les logs, développement) | smtp. La production impose smtp.
# HEROS_MAIL_DRIVER=log
# HEROS_MAIL_FROM_ADDRESS=no-reply@heros-sos.local
# HEROS_MAIL_FROM_NAME=Heros-SOS
# HEROS_SMTP_HOST=localhost
# HEROS_SMTP_PORT=1025
# HEROS_SMTP_USERNAME=
# HEROS_SMTP_PASSWORD=
# none | starttls | tls. La production interdit none.
# HEROS_SMTP_TLS_MODE=none
# HEROS_SMTP_TIMEOUT=10s
# File d'envoi asynchrone.
# HEROS_MAIL_WORKERS=4
# HEROS_MAIL_QUEUE_SIZE=256
# HEROS_MAIL_MAX_ATTEMPTS=3
# HEROS_MAIL_RETRY_DELAY=2s
# HEROS_MAIL_SEND_TIMEOUT=30s
# Adresse qui reçoit les messages du formulaire de contact (le « Bureau »). À régler en production.
# HEROS_CONTACT_RECIPIENT=contact@heros-sos.local

# --- Photos de profil --------------------------------------------------------------------------
# Dossier où les photos sont écrites. Dans Docker, c'est un volume (l'API tourne en lecture seule) :
# l'image le fixe à /var/lib/heros-sos/avatars. À sauvegarder avec la base.
# HEROS_AVATAR_DIR=data/avatars
# Taille maximale du fichier reçu, en octets (2 Mio), et côté maximal de l'image, en pixels.
# HEROS_AVATAR_MAX_BYTES=2097152
# HEROS_AVATAR_MAX_DIMENSION=1024

# --- Catalogue de films OMDb ------------------------------------------------------------------
# Clé OMDb : https://www.omdbapi.com/apikey.aspx (obligatoire en production).
# HEROS_OMDB_API_KEY=
# HEROS_OMDB_BASE_URL=https://www.omdbapi.com/
# HEROS_OMDB_TIMEOUT=5s

# --- Liens des mails (frontend) ----------------------------------------------------------------
# HEROS_PUBLIC_BASE_URL=http://localhost:3000
# Routes du frontend qui reçoivent ?token=…
# HEROS_ACTIVATION_PATH=/activation
# HEROS_PASSWORD_RESET_PATH=/reinitialisation-mot-de-passe
# HEROS_NEWSLETTER_CONFIRM_PATH=/newsletter/confirmation
# HEROS_NEWSLETTER_UNSUBSCRIBE_PATH=/newsletter/desinscription
# HEROS_EMAIL_CHANGE_CONFIRM_PATH=/changement-email/confirmation

# --- Tâches de fond ----------------------------------------------------------------------------
# HEROS_CLEANUP_INTERVAL=15m
# Durée maximale d'un passage du nettoyage : au-delà, il est interrompu et reprend au passage suivant.
# HEROS_CLEANUP_TIMEOUT=2m
# Durée de conservation des sessions expirées ou révoquées, et des jetons utilisés ou expirés.
# HEROS_SESSION_RETENTION=168h
# HEROS_TOKEN_RETENTION=168h
# Durée de conservation des commandes rejouables (clés d'idempotence des actions faites hors ligne) : un
# appareil resté hors ligne moins longtemps que cela synchronise sans doublon.
# HEROS_COMMAND_RETENTION=720h

# --- Journal d'événements ----------------------------------------------------------------------
# Fréquence de lecture des nouveaux événements (flux temps réel et journalisation), taille d'un passage, et
# délai entre deux signaux de vie sur un flux ouvert.
# HEROS_EVENTS_POLL_INTERVAL=250ms
# HEROS_EVENTS_BATCH_SIZE=500
# HEROS_EVENTS_HEARTBEAT=15s
# Flux temps réel (GET /events/stream) : flux simultanés par utilisateur, durée maximale d'un flux (le navigateur
# se reconnecte seul et la session est revérifiée), événements gardés en attente pour un lecteur lent.
# HEROS_EVENTS_MAX_STREAMS_PER_USER=5
# HEROS_EVENTS_STREAM_MAX_AGE=10m
# HEROS_EVENTS_STREAM_BUFFER=64

# --- Tableau de bord des héros -----------------------------------------------------------------
# Fraîcheur de ses statistiques (globales et par héros). Passé ce délai, la dernière valeur est encore servie
# aussitôt pendant qu'une nouvelle se calcule en arrière-plan : ces agrégats parcourent de très grosses tables.
# 0 désactive le cache (chaque appel recalcule).
# HEROS_DASHBOARD_STATS_TTL=30s

# --- Localisation des héros --------------------------------------------------------------------
# Durée de validité d'une position partagée : au-delà, elle est ignorée puis supprimée.
# HEROS_LOCATION_TTL=30m
# Rayon (km) autour d'un incident dans lequel les héros sont prévenus.
# HEROS_ALERT_RADIUS_KM=10

# --- Docker Compose (développement) ------------------------------------------------------------
# Ces variables sont lues par `make up` (docker-compose.yml et docker-compose.dev.yml, à la racine du
# dépôt), pas par l'API. Valeurs par défaut ci-dessous ; mots de passe publics, réservés au développement.
# Reverse proxy : front + API sur http://localhost:8088 (une seule origine pour le cookie de session).
# 8088 plutôt que 8080 : ce dernier est très souvent déjà pris (nginx, Jenkins, autres projets).
# PROXY_PORT=8088
# Accès direct à l'API, sans proxy (curl, outils).
# API_PORT=8081
# MAILPIT_PORT=8025
# ADMINER_PORT=8082
# Site de documentation (Docusaurus, service `docs`) : http://localhost:3001/heros-sos/
# DOCS_PORT=3001
# POSTGRES_USER=heros
# POSTGRES_PASSWORD=heros
# POSTGRES_DB=herossos
# POSTGRES_PORT=5432
# RABBITMQ_USER=heros
# RABBITMQ_PASSWORD=heros
# RABBITMQ_PORT=5672
# RABBITMQ_UI_PORT=15672
# Étiquette des images construites.
# APP_VERSION=dev
# Rotation des journaux de chaque conteneur : au plus LOG_MAX_FILE fichiers de LOG_MAX_SIZE chacun.
# Sans cette limite, Docker garde les journaux indéfiniment. S'applique à tous les services.
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
# Réseau interne du proxy et du front. L'API ne fait confiance qu'aux deux adresses fixes ci-dessous
# (proxy et front) pour connaître l'IP réelle du client ; elles doivent rester dans EDGE_SUBNET.
# EDGE_SUBNET=172.30.0.0/24
# PROXY_IP=172.30.0.2
# WEB_IP=172.30.0.3
# Plage des adresses attribuées dynamiquement aux autres conteneurs (hors adresses fixes).
# EDGE_IP_RANGE=172.30.0.128/25
