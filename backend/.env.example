# Configuration du backend Heros-SOS.
# Copier vers .env (jamais versionné) ou lancer `make env`, qui génère les secrets.
# Les lignes commentées montrent la valeur par défaut. Voir internal/config pour le détail.

# --- Général -----------------------------------------------------------------------------------
# development | production | test. La production active des contrôles stricts (HTTPS, SMTP, etc.).
# HEROS_ENV=development
# debug | info | warn | error
# HEROS_LOG_LEVEL=info
# Applique les migrations SQL au démarrage (utile en développement, déconseillé en production).
# HEROS_AUTO_MIGRATE=false

# --- Serveur HTTP ------------------------------------------------------------------------------
# HEROS_HTTP_ADDR=:8080
# HEROS_HTTP_READ_HEADER_TIMEOUT=5s
# HEROS_HTTP_READ_TIMEOUT=15s
# HEROS_HTTP_WRITE_TIMEOUT=30s
# HEROS_HTTP_IDLE_TIMEOUT=60s
# HEROS_HTTP_SHUTDOWN_TIMEOUT=20s
# HEROS_HTTP_MAX_BODY_BYTES=1048576
# Proxys dont X-Forwarded-For est cru (adresses ou réseaux, séparés par des virgules).
# HEROS_TRUSTED_PROXIES=
# Origines autorisées pour les requêtes qui modifient des données (protection CSRF).
HEROS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de données ---------------------------------------------------------------------------
HEROS_DATABASE_URL=postgres://heros:heros@localhost:5432/herossos?sslmode=disable
# HEROS_DATABASE_MAX_OPEN_CONNS=25
# HEROS_DATABASE_MAX_IDLE_CONNS=5
# HEROS_DATABASE_CONN_MAX_LIFETIME=30m
# HEROS_DATABASE_CONN_MAX_IDLE_TIME=10m
# HEROS_DATABASE_PING_TIMEOUT=5s
# Les requêtes plus lentes sont journalisées (sans leur SQL, qui peut contenir des données personnelles).
# HEROS_DATABASE_SLOW_QUERY_THRESHOLD=200ms

# --- Sessions et cookie ------------------------------------------------------------------------
# Cookie Secure et préfixe __Host- (HTTPS obligatoire). Vaut true par défaut en production.
# HEROS_COOKIE_SECURE=false
# Citoyens et héros : inactivité et durée maximale.
# HEROS_SESSION_MEMBER_IDLE=2h
# HEROS_SESSION_MEMBER_MAX=168h
# « Se souvenir de moi ».
# HEROS_SESSION_REMEMBER_IDLE=720h
# HEROS_SESSION_REMEMBER_MAX=720h
# Modérateurs.
# HEROS_SESSION_MODERATOR_IDLE=15m
# HEROS_SESSION_MODERATOR_MAX=8h
# Une écriture de last_seen_at au plus par période et par session.
# HEROS_SESSION_TOUCH_PERIOD=1m

# --- Mots de passe (argon2id) ------------------------------------------------------------------
# HEROS_ARGON2_TIME=3
# HEROS_ARGON2_MEMORY_KIB=65536
# HEROS_ARGON2_THREADS=2
# Nombre maximal de hachages simultanés (chacun consomme HEROS_ARGON2_MEMORY_KIB).
# HEROS_ARGON2_MAX_CONCURRENT=4
# HEROS_PASSWORD_MIN_LENGTH=10
# HEROS_PASSWORD_MAX_LENGTH=128

# --- Verrouillage et limitation de débit -------------------------------------------------------
# HEROS_LOCKOUT_MAX_FAILURES=5
# HEROS_LOCKOUT_BASE_DELAY=1m
# HEROS_LOCKOUT_MAX_DELAY=1h
# Format maximum/fenêtre.
# HEROS_RATE_LOGIN_PER_IP=20/15m
# HEROS_RATE_LOGIN_PER_IDENTIFIER=5/15m
# HEROS_RATE_REGISTER_PER_IP=5/1h
# HEROS_RATE_PASSWORD_RESET_PER_IP=10/1h
# HEROS_RATE_PASSWORD_RESET_PER_EMAIL=3/1h
# HEROS_RATE_MAX_TRACKED_KEYS=100000

# --- Jetons envoyés par mail -------------------------------------------------------------------
# HEROS_ACTIVATION_TOKEN_TTL=24h
# HEROS_PASSWORD_RESET_TOKEN_TTL=1h

# --- Secrets -----------------------------------------------------------------------------------
# Toute variable HEROS_X peut aussi être fournie par un fichier : on définit alors HEROS_X_FILE avec
# le chemin du fichier (secrets Docker, /run/secrets/…). Le secret n'apparaît ni dans l'environnement
# du conteneur ni dans `docker inspect`. Définir les deux formes en même temps est une erreur.
# Exemple : HEROS_CRYPTO_KEYS_FILE=/run/secrets/crypto_keys (à la place de HEROS_CRYPTO_KEYS).
# Secret CSRF : 32 octets minimum en base64. `make env` en génère un (openssl rand -base64 32).
HEROS_CSRF_SECRET=CHANGE_ME_BASE64_32_BYTES
# Clés maîtresses du chiffrement des données personnelles, au format identifiant:base64 séparés
# par des virgules. Chaque clé fait 64 octets (openssl rand -base64 64). La clé active chiffre,
# toutes les clés déchiffrent : ajouter une clé puis changer l'identifiant actif pour la rotation.
HEROS_CRYPTO_KEYS=1:CHANGE_ME_BASE64_64_BYTES
HEROS_CRYPTO_ACTIVE_KEY_ID=1

# --- Mail --------------------------------------------------------------------------------------
# log (écrit dans les logs, développement) | smtp. La production impose smtp.
# HEROS_MAIL_DRIVER=log
# HEROS_MAIL_FROM_ADDRESS=no-reply@heros-sos.local
# HEROS_MAIL_FROM_NAME=Heros-SOS
# HEROS_SMTP_HOST=localhost
# HEROS_SMTP_PORT=1025
# HEROS_SMTP_USERNAME=
# HEROS_SMTP_PASSWORD=
# none | starttls | tls. La production interdit none.
# HEROS_SMTP_TLS_MODE=none
# HEROS_SMTP_TIMEOUT=10s
# File d'envoi asynchrone.
# HEROS_MAIL_WORKERS=4
# HEROS_MAIL_QUEUE_SIZE=256
# HEROS_MAIL_MAX_ATTEMPTS=3
# HEROS_MAIL_RETRY_DELAY=2s
# HEROS_MAIL_SEND_TIMEOUT=30s

# --- Liens des mails (frontend) ----------------------------------------------------------------
# HEROS_PUBLIC_BASE_URL=http://localhost:3000
# Routes du frontend qui reçoivent ?token=…
# HEROS_ACTIVATION_PATH=/activation
# HEROS_PASSWORD_RESET_PATH=/reinitialisation-mot-de-passe

# --- Tâches de fond ----------------------------------------------------------------------------
# HEROS_CLEANUP_INTERVAL=15m
# Durée de conservation des sessions expirées ou révoquées, et des jetons utilisés ou expirés.
# HEROS_SESSION_RETENTION=168h
# HEROS_TOKEN_RETENTION=168h
