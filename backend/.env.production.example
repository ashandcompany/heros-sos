# Configuration de PRODUCTION. Copier vers .env.production (jamais versionné) puis adapter.
#
# Les SECRETS ne sont pas ici : mot de passe de la base, clés de chiffrement, secret CSRF et mot de
# passe SMTP vivent dans le dossier secrets/, généré par `make secrets` et monté en fichiers
# (/run/secrets/…) dans les conteneurs. Rien de sensible dans l'environnement ni dans `docker inspect`.
#
# Ce fichier sert à la fois à Docker Compose (--env-file) et aux conteneurs (env_file).

# --- Déploiement (lu par Docker Compose) -------------------------------------------------------
# Nom de domaine public : active HTTPS et le certificat Let's Encrypt automatique (ports 80 et 443
# ouverts vers cette machine, enregistrement DNS en place).
DOMAIN=heros-sos.example.org
# Adresse de contact Let's Encrypt (obligatoire).
ACME_EMAIL=contact@example.org
# Étiquette des images : changer à chaque livraison permet de revenir à la version précédente.
APP_VERSION=1.0.0
# Réseau interne du proxy et du front ; l'API ne fait confiance qu'à ces deux adresses fixes pour
# connaître l'IP réelle du client. Elles doivent rester dans EDGE_SUBNET.
# EDGE_SUBNET=172.30.0.0/24
# PROXY_IP=172.30.0.2
# WEB_IP=172.30.0.3
# Plage des adresses attribuées dynamiquement aux autres conteneurs (hors adresses fixes).
# EDGE_IP_RANGE=172.30.0.128/25
# HTTP_PORT=80
# HTTPS_PORT=443
POSTGRES_USER=heros
POSTGRES_DB=herossos
# RABBITMQ_USER=heros

# URL de l'API vue par le navigateur, figée dans le front au build. Laisser vide tant que le front est
# sur des données mockées ; ensuite : /api/v1 (même origine, derrière le proxy).
# NEXT_PUBLIC_API_URL=

# --- API ---------------------------------------------------------------------------------------
# Identifiant de la clé de chiffrement active, dans secrets/crypto_keys (format identifiant:clé).
# Pour une rotation : ajouter une clé (2:…) à ce fichier, puis passer cette valeur à 2.
HEROS_CRYPTO_ACTIVE_KEY_ID=1
HEROS_LOG_LEVEL=info

# Mails : un serveur SMTP chiffré est obligatoire en production (le mot de passe est dans
# secrets/smtp_password ; le laisser vide pour un relais sans authentification).
HEROS_MAIL_FROM_ADDRESS=no-reply@heros-sos.example.org
HEROS_MAIL_FROM_NAME=Heros-SOS
HEROS_SMTP_HOST=smtp.example.org
HEROS_SMTP_PORT=587
HEROS_SMTP_USERNAME=
# starttls (port 587) ou tls (port 465). `none` est refusé en production.
HEROS_SMTP_TLS_MODE=starttls

# Routes du frontend qui reçoivent ?token=… dans les liens des mails.
# HEROS_ACTIVATION_PATH=/activation
# HEROS_PASSWORD_RESET_PATH=/reinitialisation-mot-de-passe
